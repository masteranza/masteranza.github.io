---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Notes by Michał Mandrysz." />
    <title>Blog — Michał Mandrysz</title>
    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) {
        margin: 0;
        background: #191918;
        color: #f7f4ed;
        font-family: Georgia, 'Times New Roman', serif;
      }
      main { width: min(52rem, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 6rem; }
      .back, time { font-family: ui-sans-serif, system-ui, sans-serif; }
      .back { color: #aaa69d; font-size: 0.8rem; text-decoration: none; }
      h1 { margin: clamp(5rem, 12vw, 9rem) 0; font-size: clamp(4rem, 12vw, 8rem); font-weight: 400; letter-spacing: -0.06em; line-height: 0.9; }
      ol { margin: 0; padding: 0; list-style: none; }
      li { padding: 2rem 0; border-top: 1px solid #403e3a; }
      time { color: #aaa69d; font-size: 0.75rem; }
      h2 { margin: 0.75rem 0; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 400; }
      h2 a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
      li p { max-width: 40rem; margin: 0; color: #c9c5bc; font-family: ui-sans-serif, system-ui, sans-serif; line-height: 1.6; }
      a:hover { color: #d7b779; }
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="/">← Michał Mandrysz</a>
      <h1>Blog</h1>
      <ol>
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>
