---
import Archive from '../components/Archive.astro';
import BlogPreview from '../components/BlogPreview.astro';

const name = 'Michał Mandrysz';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${name}'s personal website`} />
    <title>{name}</title>
    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #faf9f6;
        color: #171717;
        font-family: Georgia, 'Times New Roman', serif;
      }

      main {
        padding-bottom: 1rem;
      }

      .hero {
        position: relative;
        display: grid;
        min-height: 100svh;
        place-items: center;
        padding: 2rem;
      }

      .site-nav {
        position: absolute;
        bottom: 2rem;
        display: flex;
        gap: 1.5rem;
      }

      .site-nav a {
        color: #5b574f;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .site-nav a:hover {
        color: #171717;
      }

      h1 {
        margin: 0;
        font-size: clamp(3.5rem, 12vw, 9rem);
        font-weight: 400;
        letter-spacing: -0.06em;
        line-height: 0.9;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="site-title">
        <h1 id="site-title">{name}</h1>
        <nav class="site-nav" aria-label="Sections">
          <a href="#blog">Blog ↓</a>
          <a href="#archive">Archive ↓</a>
        </nav>
      </section>
      <BlogPreview />
      <Archive />
    </main>
  </body>
</html>
